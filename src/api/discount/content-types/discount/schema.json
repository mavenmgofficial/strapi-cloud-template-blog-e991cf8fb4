{
  "kind": "collectionType",
  "collectionName": "discounts",
  "info": {
    "singularName": "discount",
    "pluralName": "discounts",
    "displayName": "Discount",
    "description": "Individual military discount entries"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title"
    },
    "brand": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::brand.brand",
      "inversedBy": "discounts"
    },
    "amount": {
      "type": "string"
    },
    "validFor": {
      "type": "text"
    },
    "location": {
      "type": "enumeration",
      "enum": ["Online", "In-Store", "Both"],
      "default": "Both"
    },
    "stackable": {
      "type": "boolean",
      "default": false
    },
    "isFeatured": {
      "type": "boolean",
      "default": false
    },
    "expiration": {
      "type": "date"
    },
    "howToRedeem": {
      "type": "richtext"
    },
    "whatsIncluded": {
      "type": "richtext"
    },
    "termsConditions": {
      "type": "richtext"
    },
    "discount_categories": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::discount-category.discount-category",
      "inversedBy": "discounts"
    },
    "eligibilities": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::eligibility.eligibility",
      "inversedBy": "discounts"
    },
    "state": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::state.state",
      "inversedBy": "discounts"
    },
    "faq": {
      "type": "component",
      "repeatable": true,
      "component": "deals.faq-item"
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo"
    }
  }
}
